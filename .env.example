# SomeBody Backend API Server — Environment Variables Template
# Copy this file to .env and configure values for your environment.

# Server Settings
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
ALLOWED_ORIGINS=*

# Neon PostgreSQL Database Connection (BACKEND ONLY — NEVER EXPOSE TO CLIENTS)
DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Token Secrets — MUST be 64-byte cryptographically random hex strings
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=generate_with_crypto_randomBytes_64_hex
JWT_REFRESH_SECRET=generate_with_crypto_randomBytes_64_hex



# Redis Connection (Required for BullMQ Message Expiration Worker & Realtime Cluster)
REDIS_URL=redis://default:placeholder_password@localhost:6379
